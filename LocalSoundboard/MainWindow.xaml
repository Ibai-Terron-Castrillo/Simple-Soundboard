<Window x:Class="LocalSoundboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalSoundboard" Height="820" Width="1240" MinHeight="680" MinWidth="1000"
        Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Controls.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" /><Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                <Setter Property="Padding" Value="14" />
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid TextElement.Foreground="{DynamicResource TextBrush}" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" Padding="22,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource LineBrush}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0"><TextBlock Text="LocalSoundboard" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LibraryStatusText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource IconButton}" ToolTip="Toggle light and dark mode" AutomationProperties.Name="Toggle theme" Margin="0,0,10,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE706;" /><Style.Triggers><DataTrigger Binding="{Binding IsDarkMode}" Value="True"><Setter Property="Text" Value="&#xE708;" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Button>
                    <Button Content="Choose Folder" Command="{Binding BrowseFolderCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="&#xE72C;" Command="{Binding RescanCommand}" Style="{StaticResource IconButton}" ToolTip="Rescan library" AutomationProperties.Name="Rescan library" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="20,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="312" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12"><TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="12,8,48,8" FontSize="15" AutomationProperties.Name="Search sounds" ToolTip="Search sounds" />
                    <Button Content="&#xE711;" Style="{StaticResource IconButton}" Command="{Binding ClearSearchCommand}" ToolTip="Clear search" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Clear search" /></Grid>
                <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Bank" Style="{StaticResource LabelText}" /><ComboBox ItemsSource="{Binding BankFilters}" SelectedItem="{Binding SelectedBank}" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Folder" Style="{StaticResource LabelText}" /><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="View" Style="{StaticResource LabelText}" /><ComboBox ItemsSource="{Binding QuickFilters}" SelectedItem="{Binding SelectedQuickFilter}" /></StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding SoundsView}" SelectedItem="{Binding SelectedSound}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Sound library">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Button Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="Play sound" AutomationProperties.Name="Play sound" IsEnabled="{Binding IsAvailable}" Command="{Binding DataContext.PlaySoundCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    <StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding RelativePath}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Hotkey}" FontSize="11" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Extension}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11" Margin="0,0,10,0" />
                                    <Button Grid.Column="3" Style="{StaticResource FavoriteButton}" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </Grid>
                                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Opacity" Value="0.5" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No sounds in this view" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SoundsView.IsEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
            <TabControl Grid.Column="1">
                <TabItem Header="Sound"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <TextBlock Text="{Binding SelectedSound.DisplayName, TargetNullValue='Select a sound', FallbackValue='Select a sound'}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="Display name" Style="{StaticResource LabelText}" /><TextBox Text="{Binding SelectedSound.Alias, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="Tags" Style="{StaticResource LabelText}" /><TextBox Text="{Binding SelectedSound.TagsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="Global shortcut" Style="{StaticResource LabelText}" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SelectedSound.Hotkey}" IsReadOnly="True" PreviewKeyDown="CaptureHotkey" ToolTip="Press a combination with Ctrl, Alt, or Windows. Escape clears it." />
                        <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource IconButton}" Command="{Binding ClearHotkeyCommand}" ToolTip="Clear shortcut" Margin="6,0,0,0" />
                    </Grid>
                    <Button Content="Save Sound" Command="{Binding SaveTagsCommand}" Margin="0,10,0,20" />
                    <Separator Background="{DynamicResource LineBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="Banks" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,10" />
                    <ComboBox ItemsSource="{Binding Banks}" SelectedItem="{Binding TargetBank}" Margin="0,0,0,8" />
                    <UniformGrid Columns="2" Margin="0,0,0,12"><Button Content="Add Sound" Command="{Binding AddToBankCommand}" Margin="0,0,4,0" /><Button Content="Remove Sound" Command="{Binding RemoveFromBankCommand}" Margin="4,0,0,0" /></UniformGrid>
                    <TextBlock Text="Bank name" Style="{StaticResource LabelText}" /><TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal"><Button Content="&#xE710;" Style="{StaticResource IconButton}" Command="{Binding CreateBankCommand}" ToolTip="Create bank" Margin="0,0,8,0" /><Button Content="&#xE70F;" Style="{StaticResource IconButton}" Command="{Binding RenameBankCommand}" ToolTip="Rename bank" Margin="0,0,8,0" /><Button Content="&#xE74D;" Style="{StaticResource IconButton}" Command="{Binding DeleteBankCommand}" ToolTip="Delete bank" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="&#xE74A;" Style="{StaticResource IconButton}" Command="{Binding MoveSoundUpCommand}" ToolTip="Move sound up in current bank" Margin="0,0,8,0" /><Button Content="&#xE74B;" Style="{StaticResource IconButton}" Command="{Binding MoveSoundDownCommand}" ToolTip="Move sound down in current bank" /></StackPanel>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Audio"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <TextBlock Text="Audio output" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="Device" Style="{StaticResource LabelText}" /><ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}" Margin="0,0,0,8" />
                    <Button Content="Reload Devices" Command="{Binding RefreshDevicesCommand}" Margin="0,0,0,14" />
                    <DockPanel><TextBlock Text="Volume" Style="{StaticResource LabelText}" /><TextBlock Text="{Binding VolumePercentText}" HorizontalAlignment="Right" /></DockPanel>
                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" Margin="0,8,0,16" />
                    <TextBlock Text="Playback mode" Style="{StaticResource LabelText}" /><ComboBox ItemsSource="{Binding PlaybackModeOptions}" SelectedItem="{Binding SelectedPlaybackModeOption}" Margin="0,0,0,20" />
                    <Separator Background="{DynamicResource LineBrush}" Margin="0,0,0,14" />
                    <CheckBox Content="Global shortcuts" IsChecked="{Binding HotkeysEnabled}" />
                    <TextBlock Text="Pause / resume" Style="{StaticResource LabelText}" /><TextBox Text="{Binding PauseHotkey}" IsReadOnly="True" PreviewKeyDown="CaptureHotkey" Margin="0,0,0,10" />
                    <TextBlock Text="Stop all" Style="{StaticResource LabelText}" /><TextBox Text="{Binding StopHotkey}" IsReadOnly="True" PreviewKeyDown="CaptureHotkey" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding HotkeyStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="Remote"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <TextBlock Text="Remote control" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <CheckBox Content="Remote server" IsChecked="{Binding RemoteServerEnabled}" /><CheckBox Content="Start automatically" IsChecked="{Binding StartRemoteServerAutomatically}" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding RemoteStatusText}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="Tablet / phone address" Style="{StaticResource LabelText}" />
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding RemoteUrls}" SelectedItem="{Binding RemoteUrl}" IsEnabled="{Binding IsRemoteServerRunning}" ToolTip="Tablet / phone address" AutomationProperties.Name="Tablet / phone address" />
                        <Button Grid.Column="1" Content="&#xE72C;" Style="{StaticResource IconButton}" Command="{Binding RefreshRemoteAddressesCommand}" ToolTip="Refresh network addresses" AutomationProperties.Name="Refresh network addresses" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="This PC" Style="{StaticResource LabelText}" />
                    <TextBox Text="{Binding RemoteLocalUrl, Mode=OneWay}" IsReadOnly="True" IsEnabled="{Binding IsRemoteServerRunning}" Margin="0,0,0,16" AutomationProperties.Name="This PC address" />
                    <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Port" Style="{StaticResource LabelText}" /><TextBox Text="{Binding ServerPort, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Optional PIN" Style="{StaticResource LabelText}" /><TextBox Text="{Binding RemotePin, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="For private local networks only." FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,10">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,6"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding PauseResumeGlyph}" Style="{StaticResource IconButton}" Command="{Binding TogglePauseCommand}" IsEnabled="{Binding HasPlayback}" ToolTip="{Binding PauseResumeText}" AutomationProperties.Name="Pause or resume all" Margin="0,0,8,0" />
                    <Button Content="&#xE71A;" Style="{StaticResource IconButton}" Command="{Binding StopAllCommand}" ToolTip="Stop all" AutomationProperties.Name="Stop all" Foreground="{DynamicResource DangerBrush}" />
                </StackPanel><TextBlock Text="{Binding PlaybackSummary}" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
                <ScrollViewer Grid.Row="1" MaxHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActiveSessions}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="108" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,14,0" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=TwoWay}" PreviewMouseLeftButtonDown="BeginSeek" PreviewMouseLeftButtonUp="EndSeek" PreviewKeyDown="BeginKeySeek" KeyUp="KeySeek" VerticalAlignment="Center" AutomationProperties.Name="Playback position" />
                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Button Grid.Column="3" Content="{Binding PauseGlyph}" Style="{StaticResource IconButton}" Command="{Binding TogglePauseCommand}" ToolTip="{Binding PauseText}" Margin="0,0,6,0" />
                            <Button Grid.Column="4" Content="&#xE71A;" Style="{StaticResource IconButton}" Command="{Binding StopCommand}" ToolTip="Stop sound" />
                        </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.Row="3" Padding="22,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="{Binding AvailableSoundCount, StringFormat={}{0} available}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0" /><TextBlock Text="{Binding FavoriteSoundCount, StringFormat={}{0} favorites}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
